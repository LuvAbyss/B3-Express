// AMD FidelityFX Super Resolution 1, one pass of it: PASS_EASU upscales, otherwise RCAS sharpens. The filters are
// AMD's (ffx/, MIT, license.txt there), and take a picture already tone mapped: the game's own final draw made it.
#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform Constants {
    uvec4 con0, con1, con2, con3;
    ivec2 size; // the output's
};
#define A_GPU 1
#define A_GLSL 1
#include "ffx/ffx_a.h"
#ifdef PASS_EASU
#define FSR_EASU_F 1
AF4 FsrEasuRF(AF2 p) { return textureGather(src, p, 0); }
AF4 FsrEasuGF(AF2 p) { return textureGather(src, p, 1); }
AF4 FsrEasuBF(AF2 p) { return textureGather(src, p, 2); }
#else
#define FSR_RCAS_F 1
AF4 FsrRcasLoadF(ASU2 p) { return texelFetch(src, p, 0); }
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#endif
#include "ffx/ffx_fsr1.h"
void main() {
    ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (at.x >= size.x || at.y >= size.y) return;
#ifdef PASS_EASU
    AF3 c;
    FsrEasuF(c, AU2(at), con0, con1, con2, con3);
    imageStore(dst, at, vec4(c, 1));
#else
    AF1 r, g, b;
    FsrRcasF(r, g, b, AU2(at), con0);
    imageStore(dst, at, vec4(r, g, b, 1));
#endif
}
